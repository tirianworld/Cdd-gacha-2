  dialogueCanvas: {fileID: 7392912018072263331}
  dialogueLines:
  - text: "Edacorn? Eres tu amigo m\xEDo?"
    onLineStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 4125228300761375094}
          m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
          m_MethodName: SetActive
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
