            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 1
          m_CallState: 2
    onLineEnd:
      m_PersistentCalls:
        m_Calls: []
  - text: "Hola Magordito, cuanto tiempo, veo que a ti tambien te han contratado
      para esta misi\xF3n"
    onLineStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1592132826007297031}
